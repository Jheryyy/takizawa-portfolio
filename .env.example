# Supabase Public Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL (Canonical & Sitemap)
NEXT_PUBLIC_SITE_URL=https://jtakizawa.my.id

# Optional Custom BGM Audio URL
# NEXT_PUBLIC_BGM_URL=/audio/ambient-bgm.mp3

# Server-Side Admin Authentication (Do NOT prefix with NEXT_PUBLIC_)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=replace-with-random-32-char-secret
# Optional comma-separated list of Supabase Auth emails allowed as admin
# ADMIN_EMAILS=you@example.com

# Optional Supabase Service Role Key for server-side admin API routes
# SUPABASE_SERVICE_ROLE_KEY=
